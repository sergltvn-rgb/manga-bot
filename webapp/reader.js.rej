+                seriesId: bm.series_id,
+                volume: bm.volume_id,
+                chapter: bm.chapter_key,
+                ts: new Date(bm.updated_at).getTime() || 0,
+                isServer: true
+            };
+        }
+    });
+
+    const activeSeriesKeys = Object.keys(allLocal).sort((a, b) => allLocal[b].ts - allLocal[a].ts);
+
+    if (activeSeriesKeys.length === 0) {
+        list.innerHTML = `
+            <div class="empty-state">
+                <div class="empty-icon">ЁЯУн</div>
+                <h3>╨Т╤Л ╨╡╤Й╨╡ ╨╜╨╕╤З╨╡╨│╨╛ ╨╜╨╡ ╤З╨╕╤В╨░╨╗╨╕</h3>
+                <p>╨Ю╤В╨║╤А╨╛╨╣╤В╨╡ ╨У╨╗╨░╨▓╨╜╤Г╤О, ╤З╤В╨╛╨▒╤Л ╨▓╤Л╨▒╤А╨░╤В╤М ╨╕╤Б╤В╨╛╤А╨╕╤О.</p>
+            </div>
+        `;
+        return;
+    }
+
+    const itemsHtml = activeSeriesKeys.slice(0, 10).map(key => {
+        const bm = allLocal[key];
+        const s = allData.series.find(x => String(x.id) === String(bm.seriesId));
+        if (!s) return '';
+        
+        let chTitle = "╨У╨╗╨░╨▓╨░ " + bm.chapter;
+        const v = s.volumes.find(v => String(v.volume) === String(bm.volume));
+        if (v) {
+            const ch = v.chapters.find(c => String(c.chapter) === String(bm.chapter));
+            if (ch && ch.custom_name) chTitle = ch.custom_name;
+            else if (ch) chTitle = `╨У╨╗╨░╨▓╨░ ${ch.chapter}`;
+        }
+
+        // Progress calc
+        const totalCh = s.volumes.reduce((sum, v) => sum + v.chapters.length, 0);
+        const readCount = s.volumes.reduce((sum, v) => {
+            return sum + v.chapters.filter(c => isRead(s.id, v.volume, c.chapter)).length;
+        }, 0);
+        const progress = totalCh > 0 ? Math.round((readCount / totalCh) * 100) : 0;
+
+        return `
+        <div class="series-card" style="margin-bottom:12px;" onclick="selectSeries('${s.id}')">
+            <div class="series-icon">ЁЯУЦ</div>
+            <div class="series-info">
+                <h3>${s.title}</h3>
+                <p style="font-size: 13px; color: var(--text-sec); margin-top:2px;">╨Ю╤Б╤В╨░╨╜╨╛╨▓╨╗╨╡╨╜╨╛: ╨в╨╛╨╝ ${bm.volume}, ${chTitle}</p>
+                <div class="library-progress-bar">
+                    <div class="library-progress-fill" style="width: ${progress}%"></div>
+                </div>
+                <div style="font-size: 11px; margin-top:4px; text-align:right; color: var(--text-sec);">${progress}% ╨┐╤А╨╛╤З╨╕╤В╨░╨╜╨╛</div>
+            </div>
+            <span class="series-arrow">&rsaquo;</span>
+        <    typoTooltip.style.left = `${rect.left + rect.width / 2}px`;
+    typoTooltip.style.top = `${rect.top + window.scrollY}px`;
+    typoTooltip.classList.add('visible');
+    
+    currentSelectionData = {
+        text: text,
+        context: extractContext(selection.anchorNode, range)
+    };
+});
+
+function extractContext(node, range) {
+    let block = node;
+    while(block && block !== document.body && !['P', 'DIV', 'H1', 'H2', 'H3', 'H4'].includes(block.tagName)) {
+        block = block.parentElement;
+    }
+    if (!block || block === document.body) block = node.parentElement;
+
+    const fullText = block ? (block.textContent || '') : '';
+    const selectedText = range.toString();
+    
+    const index = fullText.indexOf(selectedText);
+    if (index === -1) {
+        return { before: '', after: '' };
+    }
+    
+    const before = fullText.substring(Math.max(0, index - 50), index);
+    const after = fullText.substring(index + selectedText.length, Math.min(fullText.length, index + selectedText.length + 50));
+    
+    return { before, after };
+}
+
+typoTooltip.addEventListener('click', (e) => {
+    e.stopPropagation();
+    typoTooltip.classList.remove('visible');
+    
+    if (!currentSelectionData) return;
+    
+    if (typeof autoscrollInterval !== 'undefined' && autoscrollInterval) {
+        toggleAutoscroll();
+    }
+    
+    typoModal.classList.add('visible');
+    
+    const b = currentSelectionData.context.before;
+    const a = currentSelectionData.context.after;
+    const s = currentSelectionData.text;
+    
+    typoContextEl.innerHTML = `...${b}<span class="typo-modal-selected">${s}</span>${a}...`;
+    typoCommentEl.value = '';
+    setTimeout(() => typoCommentEl.focus(), 50);
+});
+
+function closeTypoModal() {
+    typoModal.classList.remove('visible');
+}
+
+async function submitTypoReport() {
+    if (!currentSelectionData) return;
+    if (!currentSeries || !currentChapters[currentChapterIdx]) return;
+    
+    const comment = typoCommentEl.value.trim();
+    const btn = document.querySelector('#typo-report-modal .edit-btn');
+    if(btn) {
+        btn.disabled = true;
+        btn.textContent = '...';
+    }
+    
+    try {
+        const chapter_key = currentSeries.id + "_" + currentVolume + "_" + currentChapters[currentChapterIdx].chapter;
+        const context_text = `${currentSelectionData.context.before}[${currentSelectionData.text}]${currentSelectionData.context.after}`;
+
+        const response = await apiFetch(`${API_URL}/api/typo`, {
+            method: 'POST',
+            headers: {'Content-Type': 'application/json'},
+            body: JSON.stringify({
+                chapter_key: chapter_key,
+                selected_text: currentSelectionData.text,
+                context_text: context_text,
+                comment: comment
+            })
+        });
+        
+        if (!response.ok) throw new Error('API Error');
+        alert('╨б╨┐╨░╤Б╨╕╨▒╨╛! ╨Ю╨┐╨╡╤З╨░╤В╨║╨░ ╨╛╤В╨┐╤А╨░╨▓╨╗╨╡╨╜╨░ ╤А╨╡╨┤╨░╨║╤В╨╛╤А╨░╨╝.');
+        
+        closeTypoModal();
+        window.getSelection().removeAllRanges();
+        
+    } catch (e) {
+        console.error(e);
+        alert('╨Ю╤И╨╕╨▒╨║╨░ ╨┐╤А╨╕ ╨╛╤В╨┐╤А╨░╨▓╨║╨╡ ╨╛╨┐╨╡╤З╨░╤В╨║╨╕.');
+    } finally {
+        if(btn) {
+            btn.disabled = false;
+            btn.textContent = '╨Ю╤В╨┐╤А╨░╨▓╨╕╤В╤М';
+        }
+    }
+}toscrollInterval !== 'undefined' && autoscrollInterval) {
+        toggleAutoscroll();
+    }
+    
+    typoModal.classList.add('visible');
+    
+    const b = currentSelectionData.context.before;
+    const a = currentSelectionData.context.after;
+    const s = currentSelectionData.text;
+    
+    typoContextEl.innerHTML = \...\<span class="typo-modal-selected">\</span>\...\;
+    typoCommentEl.value = '';
+    setTimeout(() => typoCommentEl.focus(), 50);
+});
+
+function closeTypoModal() {
+    typoModal.classList.remove('visible');
+}
+
+async function submitTypoReport() {
+    if (!currentSelectionData) return;
+    if (!currentSeries || !currentChapters[currentChapterIdx]) return;
+    
+    const comment = typoCommentEl.value.trim();
+    const btn = document.querySelector('#typo-report-modal .edit-btn');
+    if(btn) {
+        btn.disabled = true;
+        btn.textContent = '...';
+    }
+    
+    try {
+        const response = await apiFetch(\\/api/typo\, {
+            method: 'POST',
+            headers: {'Content-Type': 'application/json'},
+            body: JSON.stringify({
+                series_id: currentSeries.id,
+                volume: currentVolume,
+                chapter: currentChapters[currentChapterIdx].chapter,
+                selected_text: currentSelectionData.text,
+                context_before: currentSelectionData.context.before,
+                context_after: currentSelectionData.context.after,
+                comment: comment
+            })
+        });
+        
+        if (!response.ok) throw new Error('API Error');
+        
+        if (typeof tg !== 'undefined' && tg.showAlert) {
+            tg.showAlert('Report sent!');
+        } else {
+            alert('Report sent!');
+        }
+        
+        closeTypoModal();
+        window.getSelection().removeAllRanges();
+        
+    } catch (e) {
+        console.error(e);
+        if (typeof tg !== 'undefined' && tg.showAlert) {
+            tg.showAlert('Report failed.');
+        } else {
+            alert('Report failed.');
+        }
+    } finally {
+        if(btn) {
+            btn.disabled = false;
+            btn.textContent = 'Submit';
+        }
+    }
+}
