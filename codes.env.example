BOT_TOKEN=your_telegram_bot_token
GROQ_API_KEY=your_groq_api_key

# --- Локальный inference-сервер (Ollama через Cloudflare Tunnel) ---
# Если пусто — бот работает только через Groq (старое поведение).
# Пример: https://smooth-camera-xxx.trycloudflare.com  (без /v1 на конце)
GEMMA_URL=
GEMMA_MODEL=huihui_ai/gemma3-abliterated:4b
GEMMA_TIMEOUT=30

# Public web URL used in Telegram WebApp buttons.
WEBAPP_URL=https://example.com

# Public API URL (optional). If empty, WebApp uses current origin.
API_HOST=https://api.example.com

# Optional extra CORS allowlist origins (comma-separated).
# Example: https://staging.example.com,https://web.telegram.org
WEBAPP_CORS_ALLOWLIST=

# Optional Telegram Mini App direct-link short name from BotFather.
# Leave empty to use the safe callback subscription check button.
GIVEAWAY_MINI_APP_SHORT_NAME=

# Maximum accepted API request body size in bytes.
API_MAX_BODY_BYTES=262144
