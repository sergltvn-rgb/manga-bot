# Example Nginx reverse proxy for Alya bot + WebApp reader.
# Adjust domain, TLS paths, and upstream host/port for your server.

user www-data;
worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    server_tokens off;

    # Cache policy for versioned webapp assets (?v=12).
    map $arg_v $webapp_asset_cache_control {
        default "public, max-age=31536000, immutable";
        ""      "public, max-age=86400";
    }

    # Compression (gzip + brotli)
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 512;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        application/rss+xml
        image/svg+xml;

    # Requires nginx brotli module (ngx_brotli).
    brotli on;
    brotli_comp_level 5;
    brotli_static on;
    brotli_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml;

    upstream alya_backend {
        server 127.0.0.1:8080;
        keepalive 32;
    }

    server {
        listen 80;
        server_name alyabot.duckdns.org;
        return 301 https://$host$request_uri;
    }

    server {
        listen 443 ssl http2;
        server_name alyabot.duckdns.org;

        # TODO: update TLS paths
        ssl_certificate     /etc/letsencrypt/live/alyabot.duckdns.org/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/alyabot.duckdns.org/privkey.pem;

        # API
        location /api/ {
            proxy_pass http://alya_backend;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Root redirect handled by app
        location = / {
            proxy_pass http://alya_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Do not hard-cache app shell / SW / manifest / generated JSON
        location = /webapp/reader.html {
            proxy_pass http://alya_backend;
            add_header Cache-Control "no-cache" always;
            add_header Vary "Accept-Encoding" always;
        }
        location = /webapp/index.html {
            proxy_pass http://alya_backend;
            add_header Cache-Control "no-cache" always;
            add_header Vary "Accept-Encoding" always;
        }
        location = /webapp/sw.js {
            proxy_pass http://alya_backend;
            add_header Cache-Control "no-cache" always;
            add_header Vary "Accept-Encoding" always;
        }
        location = /webapp/manifest.json {
            proxy_pass http://alya_backend;
            add_header Cache-Control "no-cache" always;
            add_header Vary "Accept-Encoding" always;
        }
        location = /webapp/chapters_data.json {
            proxy_pass http://alya_backend;
            add_header Cache-Control "no-cache" always;
            add_header Vary "Accept-Encoding" always;
        }

        # Cache static assets
        location ~* ^/webapp/.*\.(?:css|js|mjs|map|woff2?|ttf|otf|svg|png|jpe?g|gif|webp|ico)$ {
            proxy_pass http://alya_backend;
            add_header Cache-Control $webapp_asset_cache_control always;
            add_header Vary "Accept-Encoding" always;
        }

        # Default webapp files
        location /webapp/ {
            proxy_pass http://alya_backend;
            add_header Cache-Control "public, max-age=3600" always;
            add_header Vary "Accept-Encoding" always;
        }
    }
}
